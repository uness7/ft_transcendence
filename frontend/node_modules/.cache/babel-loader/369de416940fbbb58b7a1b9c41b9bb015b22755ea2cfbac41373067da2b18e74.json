{"ast":null,"code":"export default {\n  props: ['id'],\n  data() {\n    return {\n      participants: [],\n      // Remplace par des données réelles une fois le backend prêt\n      joined: false,\n      alias: ''\n    };\n  },\n  methods: {\n    promptAlias() {\n      let aliasInput;\n      do {\n        aliasInput = prompt(\"Please enter your alias (max 10 characters):\");\n        if (aliasInput && aliasInput.length > 10) {\n          alert(\"Alias must be 10 characters or less.\");\n        }\n      } while (aliasInput && aliasInput.length > 10);\n      if (aliasInput) {\n        this.alias = aliasInput;\n        this.joined = true;\n        // Ici tu peux aussi envoyer l'alias au backend pour l'enregistrer\n      }\n    },\n    leaveTournament() {\n      this.joined = false;\n      this.alias = '';\n      // Ici tu peux aussi informer le backend que l'utilisateur a quitté le tournoi\n    }\n  }\n};","map":{"version":3,"names":["props","data","participants","joined","alias","methods","promptAlias","aliasInput","prompt","length","alert","leaveTournament"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/views/TournamentDetails.vue"],"sourcesContent":["<template>\n    <div class=\"content\">\n      <h1>Tournament Details</h1>\n      <p>Details for tournament with ID: {{ id }}</p>\n      <p>Number of participants: {{ participants.length }}</p>\n  \n      <div v-if=\"!joined\">\n        <button class=\"btn join-btn\" @click=\"promptAlias\">Join Tournament</button>\n      </div>\n      <div v-else>\n        <p>Welcome, {{ alias }}!</p>\n        <button class=\"btn leave-btn\" @click=\"leaveTournament\">Leave Tournament</button>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    props: ['id'],\n    data() {\n      return {\n        participants: [], // Remplace par des données réelles une fois le backend prêt\n        joined: false,\n        alias: '',\n      };\n    },\n    methods: {\n      promptAlias() {\n        let aliasInput;\n        do {\n          aliasInput = prompt(\"Please enter your alias (max 10 characters):\");\n          if (aliasInput && aliasInput.length > 10) {\n            alert(\"Alias must be 10 characters or less.\");\n          }\n        } while (aliasInput && aliasInput.length > 10);\n        \n        if (aliasInput) {\n          this.alias = aliasInput;\n          this.joined = true;\n          // Ici tu peux aussi envoyer l'alias au backend pour l'enregistrer\n        }\n      },\n      leaveTournament() {\n        this.joined = false;\n        this.alias = '';\n        // Ici tu peux aussi informer le backend que l'utilisateur a quitté le tournoi\n      },\n    },\n  };\n  </script>\n  \n  <style scoped>\n  \n  @font-face {\n      font-family: '8bit';\n      src: url('../assets/font/8bit.ttf') format('truetype');\n  }\n  \n  .content {\n    color: white;\n    background-color: var(--background-color);\n    margin-top: 200px;\n    text-align: center;\n    padding: 20px;\n    font-family: '8bit', sans-serif;\n  }\n  \n  h1 {\n    font-size: 2.5rem;\n    margin-bottom: 20px;\n    color: #f0f0f0;\n  }\n  \n  p {\n    font-size: 1.2rem;\n    color: #b3b3b3;\n  }\n  \n  .btn {\n    padding: 10px 20px;\n    font-size: 1rem;\n    color: white;\n    border-radius: 5px;\n    border: none;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n  }\n  \n  .join-btn {\n    background-color: #28a745; /* Vert */\n  }\n  \n  .join-btn:hover {\n    background-color: #218838; /* Vert foncé */\n  }\n  \n  .leave-btn {\n    background-color: #dc3545; /* Rouge */\n  }\n  \n  .leave-btn:hover {\n    background-color: #c82333; /* Rouge foncé */\n  }\n  </style>\n  "],"mappings":"AAiBE,eAAe;EACbA,KAAK,EAAE,CAAC,IAAI,CAAC;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,EAAE;MAAE;MAClBC,MAAM,EAAE,KAAK;MACbC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZ,IAAIC,UAAU;MACd,GAAG;QACDA,UAAS,GAAIC,MAAM,CAAC,8CAA8C,CAAC;QACnE,IAAID,UAAS,IAAKA,UAAU,CAACE,