{"ast":null,"code":"import Chart from \"chart.js/auto\";\nexport default {\n  data() {\n    return {\n      username: \"Player 1\",\n      profileImageUrl: require('../assets/img/pp/okazdar.jpg'),\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3,\n      primaryColor: '' // Initialiser une variable pour la couleur primaire\n    };\n  },\n  mounted() {\n    // Obtenez la couleur de la variable CSS\n    this.primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim();\n    const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n    const canvas = document.getElementById(\"gamesChart\");\n    canvas.height = 500;\n    new Chart(ctx, {\n      type: \"pie\",\n      data: {\n        labels: [\"Gagnées\", \"Perdues\"],\n        datasets: [{\n          label: \"Parties\",\n          data: [this.gamesWon, this.gamesLost],\n          backgroundColor: [this.primaryColor, \"#222\"] // Utilisez la couleur primaire ici\n        }]\n      },\n      options: {\n        plugins: {\n          legend: {\n            position: 'top',\n            labels: {\n              padding: 20,\n              color: '#FFFFFF'\n            }\n          }\n        },\n        layout: {\n          padding: {\n            top: 0,\n            bottom: 0,\n            left: 0,\n            right: 0\n          }\n        },\n        maintainAspectRatio: false\n      }\n    });\n  }\n};","map":{"version":3,"names":["Chart","data","username","profileImageUrl","require","gamesWon","gamesLost","winRate","tournamentsWon","primaryColor","mounted","getComputedStyle","document","documentElement","getPropertyValue","trim","ctx","getElementById","getContext","canvas","height","type","labels","datasets","label","backgroundColor","options","plugins","legend","position","padding","color","layout","top","bottom","left","right","maintainAspectRatio"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/components/UserProfile.vue"],"sourcesContent":["<template>\n  <div class=\"content\">\n    <div class=\"profile-section\">\n      <img :src=\"profileImageUrl\" alt=\"Profile Image\" class=\"profile-img\">\n      <h1 class=\"username\">{{ username }}</h1>\n    </div>\n    <div class=\"main-section\">\n      <div class=\"left-section\">\n        <div class=\"stat-grid\">\n          <div class=\"stat\">\n            <h2>Parties gagnées</h2>\n            <p>{{ gamesWon }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Parties perdues</h2>\n            <p>{{ gamesLost }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Winrate</h2>\n            <p>{{ winRate }}%</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Tournois gagnés</h2>\n            <p>{{ tournamentsWon }}</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"divider\"></div>\n      <div class=\"right-section\">\n        <canvas id=\"gamesChart\"></canvas>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport Chart from \"chart.js/auto\";\n\nexport default {\n  data() {\n    return {\n      username: \"Player 1\",\n      profileImageUrl: require('../assets/img/pp/okazdar.jpg'),\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3,\n      primaryColor: '', // Initialiser une variable pour la couleur primaire\n    };\n  },\n  mounted() {\n    // Obtenez la couleur de la variable CSS\n    this.primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim();\n\n    const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n\n    const canvas = document.getElementById(\"gamesChart\");\n    canvas.height = 500;\n\n    new Chart(ctx, {\n      type: \"pie\",\n      data: {\n        labels: [\"Gagnées\", \"Perdues\"],\n        datasets: [\n          {\n            label: \"Parties\",\n            data: [this.gamesWon, this.gamesLost],\n            backgroundColor: [this.primaryColor, \"#222\"], // Utilisez la couleur primaire ici\n          },\n        ],\n      },\n      options: {\n        plugins: {\n          legend: {\n            position: 'top',\n            labels: {\n              padding: 20,\n              color: '#FFFFFF',\n            },\n          },\n        },\n        layout: {\n          padding: {\n            top: 0,\n            bottom: 0,\n            left: 0,\n            right: 0,\n          },\n        },\n        maintainAspectRatio: false,\n      },\n    });\n  }\n};\n</script>\n\n<style scoped>\n.content {\n  color: rgb(255, 255, 255);\n  margin-left: 400px;\n  background-color: var(--background-color);\n  font-family: '8bit', sans-serif;\n}\n\n.profile-section {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 50px;\n  margin-bottom: 80px;\n}\n\n.profile-img {\n  border-radius: 10%;\n  width: 10%;\n  margin-top: -40px;\n  border: 2px solid white;\n}\n\n.username {\n  font-size: 4rem;\n  margin-top: 0px;\n}\n\n.main-section {\n  display: flex;\n  justify-content: space-between;\n}\n\n.left-section {\n  width: 45%;\n}\n\n.stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 30px;\n}\n\n.stat {\n  text-align: center;\n  background-color: rgb(15, 15, 15);\n  padding: 30px;\n  border: 1px solid rgb(50, 50, 50);\n  border-radius: 8px;\n  font-size: 1.2rem;\n}\n\n.divider {\n  width: 2px;\n  background-color: grey;\n}\n\n.right-section {\n  width: 45%;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n}\n\ncanvas {\n  width: 100%;\n  max-width: 350px;\n}\n</style>\n"],"mappings":"AAoCA,OAAOA,KAAI,MAAO,eAAe;AAEjC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,UAAU;MACpBC,eAAe,EAAEC,OAAO,CAAC,8BAA8B,CAAC;MACxDC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,cAAc,EAAE,CAAC;MACjBC,YAAY,EAAE,EAAE,CAAE;IACpB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAACD,YAAW,GAAIE,gBAAgB,CAACC,QAAQ,CAACC,e