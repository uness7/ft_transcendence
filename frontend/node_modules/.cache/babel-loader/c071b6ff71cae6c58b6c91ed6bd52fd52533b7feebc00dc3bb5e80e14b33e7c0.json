{"ast":null,"code":"import { createElementVNode as _createElementVNode, openBlock as _openBlock, createElementBlock as _createElementBlock, pushScopeId as _pushScopeId, popScopeId as _popScopeId } from \"vue\";\nconst _withScopeId = n => (_pushScopeId(\"data-v-52f98f82\"), n = n(), _popScopeId(), n);\nconst _hoisted_1 = {\n  class: \"content\"\n};\nconst _hoisted_2 = /*#__PURE__*/_withScopeId(() => /*#__PURE__*/_createElementVNode(\"canvas\", {\n  id: \"game-canvas\"\n}, null, -1 /* HOISTED */));\nconst _hoisted_3 = [_hoisted_2];\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [..._hoisted_3]);\n}","map":{"version":3,"names":["class","_createElementVNode","id","_hoisted_2","_createElementBlock","_hoisted_1","_hoisted_3"],"sources":["/goinfre/jnorget/ouiiiiin/frontend/src/views/PongAiView.vue"],"sourcesContent":["<template>\n\t<div class=\"content\">\n\t\t<canvas id=\"game-canvas\"></canvas>\n\t</div>\n</template>\n\n<script>\nimport Ball from \"../pong/entities/ball.js\";\nimport PlayerPaddle from \"../pong/entities/player-paddle.js\";\nimport AiPaddle from \"../pong/entities/ai-paddle.js\";\nimport TextHUD from \"../pong/entities/text-hud.js\";\nimport Vec2 from \"../pong/maths/vec2.js\";\nimport CollisionDetector from \"../pong/misc/collision-detector.js\";\nimport gameConfig from \"../pong/game/config.js\";\nimport BoundingBox from \"../pong/misc/bounding-box.js\";\nimport Rect2 from \"../pong/maths/rect2.js\";\n\nexport default {\n\tname: 'PongAiView',\n\tdata() {\n\t\treturn {\n\t\t\tgame: null,\n\t\t\tgameBox: null,\n\t\t\tleftToggleMoveUp: false,\n\t\t\tleftToggleMoveDown: false,\n\t\t};\n\t},\n\tmounted() {\n\t\tthis.initializeGame();\n\t\twindow.addEventListener(\"resize\", this.onResize);\n\t},\n\tbeforeDestroy() {\n\t\twindow.removeEventListener(\"resize\", this.onResize);\n\t},\n\tmethods: {\n\t\tinitializeGame() {\n\t\t\tconst canvas = document.querySelector(\"#game-canvas\");\n\t\t\tconst ctx = canvas.getContext(\"2d\");\n\t\t\tthis.gameBox = new BoundingBox(new Rect2(new Vec2(0, 0), new Vec2(canvas.width, canvas.height)));\n\n\t\t\tthis.game = new Pong(ctx, this.gameBox);\n\t\t\tthis.game.load();\n\t\t},\n\t\tonResize() {\n\t\t\tconst canvas = document.querySelector(\"#game-canvas\");\n\t\t\tcanvas.width = gameConfig.canvas.width;\n\t\t\tcanvas.height = gameConfig.canvas.height;\n\t\t\tthis.gameBox = new BoundingBox(new Rect2(new Vec2(0, 0), new Vec2(canvas.width, canvas.height)));\n\t\t}\n\t}\n};\n\nclass Pong {\n\tconstructor(ctx, gameBox) {\n\t\tthis.ctx = ctx;\n\t\tthis.gameBox = gameBox;\n\t\tthis.timeLastFrame = 0;\n\t\tthis.isLeftServe = true;\n\t\tthis.leftScore = 0;\n\t\tthis.rightScore = 0;\n\t\tthis.state = GameState.Menu;\n\t\tthis.entities = {\n\t\t\tplayerPaddle: new PlayerPaddle(ctx, gameBox, true),\n\t\t\taiPaddle: new AiPaddle(ctx, gameBox, false),\n\t\t\tball: new Ball(\n\t\t\t\tctx,\n\t\t\t\tgameBox.getCenter().clone(),\n\t\t\t\tgameConfig.ball.radius,\n\t\t\t\tnew Vec2(gameConfig.ball.speed, 0),\n\t\t\t\tgameConfig.ball.color\n\t\t\t),\n\t\t\tgameStateText: new TextHUD(\n\t\t\t\tctx,\n\t\t\t\t\"\",\n\t\t\t\tnew Vec2(gameBox.getHalfWidth(), gameConfig.text.yPaddingMain),\n\t\t\t\tgameConfig.text.fontMain,\n\t\t\t\tgameConfig.text.color\n\t\t\t),\n\t\t\tleftScoreText: new TextHUD(\n\t\t\t\tctx,\n\t\t\t\t\"0\",\n\t\t\t\tnew Vec2(gameBox.getHalfWidth() / 2, gameConfig.text.yPaddingScores),\n\t\t\t\tgameConfig.text.fontScores,\n\t\t\t\tgameConfig.text.color\n\t\t\t),\n\t\t\trightScoreText: new TextHUD(\n\t\t\t\tctx,\n\t\t\t\t\"0\",\n\t\t\t\tnew Vec2(gameBox.getHalfWidth() * 3 / 2, gameConfig.text.yPaddingScores),\n\t\t\t\tgameConfig.text.fontScores,\n\t\t\t\tgameConfig.text.color\n\t\t\t),\n\t\t};\n\t\tthis.timeAccumulator = 0;\n\t}\n\n\trender() {\n\t\tthis.ctx.clearRect(0, 0, this.gameBox.getSize().x, this.gameBox.getSize().y);\n\t\tObject.values(this.entities).forEach(entity => entity.render());\n\t}\n\n\tgameStartTimer() {\n\t\tthis.state = GameState.Wait;\n\t\treturn new Promise(resolve => {\n\t\t\tlet timeToWait = gameConfig.game.timeBeforeGameStarts;\n\t\t\tconst timer = setInterval(() => {\n\t\t\t\tthis.entities.gameStateText.text = `GAME STARTS IN ${timeToWait}...`;\n\t\t\t\tthis.render();\n\t\t\t\ttimeToWait--;\n\t\t\t\tif (timeToWait < 0) {\n\t\t\t\t\tclearInterval(timer);\n\t\t\t\t\tresolve();\n\t\t\t\t}\n\t\t\t}, 1_000);\n\t\t});\n\t}\n\n\tload() {\n\t\tthis.state = GameState.Menu;\n\t\tthis.gameLoop();\n\t}\n\n\tcheckCollisions() {\n\t\tconst ball = this.entities.ball;\n\t\tconst playerPaddle = this.entities.playerPaddle;\n\t\tconst aiPaddle = this.entities.aiPaddle;\n\n\t\t// collision with left bound\n\t\tif (this.gameBox.isBeyondLeftBound(ball.pos)) {\n\t\t\tif (!gameConfig.game.playerImmortal)\n\t\t\t\tthis.rightScore++;\n\t\t\tthis.state = GameState.Serve;\n\t\t\tthis.isLeftServe = true;\n\t\t}\n\n\t\t// collision with right bound\n\t\tif (this.gameBox.isBeyondRightBound(ball.pos)) {\n\t\t\tthis.leftScore++;\n\t\t\tthis.state = GameState.Serve;\n\t\t\tthis.isLeftServe = false;\n\t\t}\n\n\t\t// collision with bottom bound\n\t\tif (this.gameBox.isBeyondBottomBound(ball.getBottomPoint()) && ball.isMovingDown()) {\n\t\t\tball.inverseYSpeed();\n\t\t}\n\n\t\t// collision with top bound\n\t\tif (this.gameBox.isBeyondTopBound(ball.getTopPoint()) && ball.isMovingUp()) {\n\t\t\tball.inverseYSpeed();\n\t\t}\n\n\t\t// collision with left paddle\n\t\tif (CollisionDetector.pointToRect(ball.pos, playerPaddle.rect) && ball.isMovingLeft()) {\n\t\t\tplayerPaddle.collideBall(ball);\n\t\t}\n\n\t\t// collision with right paddle\n\t\tif (CollisionDetector.pointToRect(ball.pos, aiPaddle.rect) && ball.isMovingRight()) {\n\t\t\taiPaddle.collideBall(ball);\n\t\t\taiPaddle.changePosition();\n\t\t}\n\t}\n\n\tcheckGameFinished() {\n\t\tif (this.leftScore === gameConfig.game.maxScore || this.rightScore === gameConfig.game.maxScore) {\n\t\t\tthis.entities.gameStateText.text = this.leftScore === gameConfig.game.maxScore ? \"PLAYER WINS\" : \"PLAYER LOST\";\n\t\t\tthis.state = GameState.Wait;\n\t\t\tsetTimeout(() => {\n\t\t\t\tthis.state = GameState.Menu;\n\t\t\t}, 3 * 1000);\n\t\t}\n\t}\n\n\tcheckServeSide() {\n\t\tconst ball = this.entities.ball;\n\t\tif (this.state === GameState.Serve) {\n\t\t\tif (this.isLeftServe) {\n\t\t\t\tthis.entities.gameStateText.text = \"PLAYER SERVES\";\n\t\t\t\tball.speed.scale(-1);\n\t\t\t} else {\n\t\t\t\tthis.entities.gameStateText.text = \"AI SERVES\";\n\t\t\t\tball.speed.copy(ball.resetSpeed);\n\t\t\t}\n\n\t\t\tif (this.state === GameState.Serve) {\n\t\t\t\tthis.state = GameState.Wait;\n\t\t\t\tsetTimeout(() => {\n\t\t\t\t\tthis.state = GameState.Play;\n\t\t\t\t}, gameConfig.game.timeBeforeRoundStarts * 1000);\n\t\t\t}\n\t\t}\n\t}\n\n\tupdateEntitiesPosition(dt) {\n\t\tconst ball = this.entities.ball;\n\t\tconst playerPaddle = this.entities.playerPaddle;\n\t\tconst aiPaddle = this.entities.aiPaddle;\n\n\t\tif (this.leftToggleMoveUp) playerPaddle.moveUp(dt);\n\t\tif (this.leftToggleMoveDown) playerPaddle.moveDown(dt);\n\t\tplayerPaddle.updatePosition();\n\t\taiPaddle.checkMovement(dt, ball.pos, gameConfig.ai.chaseBuffer);\n\t\tball.move(dt);\n\t}\n\n\tgameLoop() {\n\t\tif (!this.timeLastFrame) this.timeLastFrame = performance.now();\n\t\tconst timeNow = performance.now();\n\t\tconst dt = (timeNow - this.timeLastFrame) / 1000;\n\t\tthis.timeAccumulator += timeNow - this.timeLastFrame;\n\t\tthis.timeLastFrame = timeNow;\n\n\t\tif (this.state === GameState.Menu) { // STATE MENU\n\t\t\tthis.entities.gameStateText.text = \"PRESS SPACE TO START\";\n\t\t\tthis.leftScore = 0;\n\t\t\tthis.rightScore = 0;\n\t\t} else if (this.state === GameState.Play) { // STATE PLAY\n\t\t\tthis.entities.gameStateText.text = \"\";\n\t\t\tthis.updateEntitiesPosition(dt);\n\t\t\tthis.checkCollisions();\n\t\t} else if (this.state === GameState.Serve) { // STATE SERVE\n\t\t\tball.reset(this.isLeftServe);\n\t\t\tplayerPaddle.reset();\n\t\t\taiPaddle.reset();\n\t\t\tthis.toggleMoveResetAll();\n\t\t\tthis.checkGameFinished();\n\t\t\tthis.checkServeSide();\n\t\t}\n\t\tthis.entities.rightScoreText.text = this.rightScore.toString();\n\t\tthis.entities.leftScoreText.text = this.leftScore.toString();\n\t\tthis.render();\n\t\trequestAnimationFrame(this.gameLoop.bind(this));\n\t}\n\n\ttoggleMoveResetAll() {\n\t\tthis.leftToggleMoveUp = false;\n\t\tthis.leftToggleMoveDown = false;\n\t}\n}\n</script>\n\n\n<style scoped>\n#game-canvas {\n\tdisplay: block;\n\tbackground: black;\n\tmargin: auto;\n\tposition: absolute;\n\ttop: 0;\n\tbottom: 0;\n\tleft: 0;\n\tright: 0;\n\tborder: 2px solid white;\n}\n</style>\n"],"mappings":";;;EACMA,KAAK,EAAC;AAAS;gEACnBC,mBAAA,CAAkC;EAA1BC,EAAE,EAAC;AAAa;oBAAxBC,UAAkC,C;;uBADnCC,mBAAA,CAEM,OAFNC,UAEM,EAHP,IAAAC,UAAA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}