          </li> \n        </ul>\n      </div>\n        </div>\n      </div>\n    <div v-else-if=\"loading\">\n      <p>Chargement...</p>\n    </div>\n    <div v-else>\n      <p>Impossible de charger les donnees de l'utilisateur.</p>\n    </div>\n  </div>\n</template>\n    \n<script>\n    import axios from 'axios';\n  \n    export default {\n    name: 'UserProfile',\n    props: ['id'],\n    data() {\n      return {\n        user: null,\n        loading: true,\n      };\n    },\n    mounted() {\n      this.fetchUser();\n    },\n    methods: {\n        fetchUser() {\n        axios.get(`https://jsonplaceholder.typicode.com/users/${this.id}`)\n            .then(response => {\n            this.user = response.data;\n            })\n            .catch(error => {\n            console.error('Erreur:', error);\n            });\n        }\n    }\n  };\n  </script>\n  \n<style scoped>\n\n@font-face {\n  font-family: '8bit';\n  src: url('../assets/font/8bit.ttf') format('truetype');\n}\n\n.content {\n  color: white;\n  margin-top: 80px;   /* <--- ne pas trop changer */\n  font-family: '8bit',sans-serif;\n  margin-left: 500px;\n  font-size: 20px;\n}\n\n.profile-header {\n  text-align: center;\n}\n.profile{\n  display: flex;\n  align-items: center;\n}\n.profile-photo {\n  width: 120px;\n  height: 120px;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 3px solid #ddd;\n  margin-right: 30px;\n}\n\n.profile-info{\n  display: flex;\n  flex-direction: column;\n}\n\n#username {\n  font-size: 80px;\n  margin: 0 auto;\n}\n\n.profile-stats {\n  margin-top: 20px;\n}\n\n.stat-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 10px 0;\n  border-bottom: 1px solid #eee;\n}\n\n.stat-label {\n  font-weight: bold;\n}\n\n.stat-value {\n  color: #333;\n}\n\n.friends-list {\n  margin-top: 20px;\n}\n\n.friends-list h2 {\n  font-size: 24px;\n}\n\n.friends-list ul {\n  list-style-type: none;\n  padding: 0;\n}\n\n.friends-list li {\n  padding: 5px 0;\n}\n\nbutton {\n  margin-top: 20px;\n  padding: 10px 20px;\n  font-size: 16px;\n  border: none;\n  background-color: #007bff;\n  color: white;\n  border-radius: 5px;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #0056b3;\n}\n</style> \n\n<!-- <template>\n  <div class=\"content\">\n    <div v-if=\"user\">\n      <div class=\"profile-header\">\n        <img :src=\"user.profilePhoto\" alt=\"Profile Photo\" class=\"profile-photo\"/> \n        <h1 id=\"username\">{{ user.name }}</h1>\n        <p>{{ user.email }}</p>\n        <p>{{ user.id }}</p>\n      </div>\n      <div class=\"profile-stats\">\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">Games Played:</span>\n          <span class=\"stat-value\">{{ user.id }}</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">Wins:</span>\n          <span class=\"stat-value\">{{ user.id }}</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">Losses:</span>\n          <span class=\"stat-value\">{{ user.id }}</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">Total Score:</span>\n          <span class=\"stat-value\">{{ user.id }}</span>\n        </div>\n      </div>\n      <div class=\"friends-list\">\n        <h2>Friends</h2>\n         <ul>\n          <li v-for=\"friend in user.friends\" :key=\"friend.id\">\n            {{ user.id }}\n          </li> \n        </ul>\n      </div>\n      <button @click=\"updateUserData\">Update Data</button>\n    </div>\n    <div v-else-if=\"loading\">\n      <p>Chargement...</p>\n    </div>\n    <div v-else>\n      <p>Impossible de charger les données de l'utilisateur.</p>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'UserProfile',\n  props: ['id'],\n  data() {\n    return {\n      user: null,\n      loading: true\n    };\n  },\n  mounted() {\n    this.fetchUser();\n  },\n  methods: {\n    fetchUser() {\n      this.loading = true;\n      axios.get(`https://api.example.com/users/${this.id}`)\n        .then(response => {\n          this.user = response.data;\n          this.loading = false;\n        })\n        .catch(error => {\n          console.error('Erreur:', error);\n          this.loading = false;\n        });\n    },\n    updateUserData() {\n      axios.get(`https://api.example.com/users/${this.id}`)\n        .then(response => {\n          this.user = response.data;\n        })\n        .catch(error => {\n          console.error('Erreur:', error);\n        });\n    }\n  }\n};\n</script>\n -->\n"],"mappings":"AA8CI,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACfC,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE,CAAC,IAAI,CAAC;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,IAAI;MACVC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACLD,SAASA,CAAA,EAAG;MACZP,KAAK,CAACS,GAAG,CAAC,8CAA8C,IAAI,CAACC,EAAE,EAAE,EAC5DC,IAAI,CAACC,QAAO,IAAK;QAClB,IAAI,CAACR,IAAG,GAAIQ,QAAQ,CAACT,IAAI;MACzB,CAAC,EACAU,KAAK,CAACC,KAAI,IAAK;QAChBC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MAC/B,CAAC,CAAC;IACN;EACJ;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}