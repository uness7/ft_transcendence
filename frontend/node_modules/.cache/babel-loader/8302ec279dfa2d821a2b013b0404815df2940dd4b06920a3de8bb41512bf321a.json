{"ast":null,"code":"import Chart from \"chart.js/auto\";\nexport default {\n  data() {\n    return {\n      username: \"Player 1\",\n      // profileImageUrl: \"https://via.placeholder.com/100\",\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3\n    };\n  },\n  mounted() {\n    const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n    const canvas = document.getElementById(\"gamesChart\");\n    canvas.height = 500;\n    new Chart(ctx, {\n      type: \"pie\",\n      data: {\n        labels: [\"Gagnées\", \"Perdues\"],\n        datasets: [{\n          label: \"Parties\",\n          data: [this.gamesWon, this.gamesLost],\n          backgroundColor: [\"#3c4e3b\", \"#662121\"]\n        }]\n      },\n      options: {\n        plugins: {\n          legend: {\n            position: 'top',\n            labels: {\n              padding: 20\n            }\n          }\n        },\n        layout: {\n          padding: {\n            top: 0,\n            bottom: 0,\n            left: 0,\n            right: 0\n          }\n        },\n        maintainAspectRatio: false\n      }\n    });\n  }\n};","map":{"version":3,"names":["Chart","data","username","gamesWon","gamesLost","winRate","tournamentsWon","mounted","ctx","document","getElementById","getContext","canvas","height","type","labels","datasets","label","backgroundColor","options","plugins","legend","position","padding","layout","top","bottom","left","right","maintainAspectRatio"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/components/UserProfile.vue"],"sourcesContent":["<template>\n  <div class=\"content\">\n    <div class=\"profile-section\">\n      <img src=\"profileImageUrl\" alt=\"Profile Image\" class=\"profile-img\">\n      <h1 class=\"username\">{{ username }}</h1>\n    </div>\n    <div class=\"main-section\">\n      <div class=\"left-section\">\n        <div class=\"stat-grid\">\n          <div class=\"stat\">\n            <h2>Parties gagnées</h2>\n            <p>{{ gamesWon }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Parties perdues</h2>\n            <p>{{ gamesLost }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Winrate</h2>\n            <p>{{ winRate }}%</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Tournois gagnes</h2>\n            <p>{{ tournamentsWon }}</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"divider\"></div>\n      <div class=\"right-section\">\n        <canvas id=\"gamesChart\"></canvas>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport Chart from \"chart.js/auto\";\n\nexport default {\n  data() {\n    return {\n      username: \"Player 1\",\n      // profileImageUrl: \"https://via.placeholder.com/100\",\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3,\n    };\n  },\n  mounted() {\n  const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n  \n  const canvas = document.getElementById(\"gamesChart\");\n  canvas.height = 500;\n  \n  new Chart(ctx, {\n    type: \"pie\",\n    data: {\n      labels: [\"Gagnées\", \"Perdues\"],\n      datasets: [\n        {\n          label: \"Parties\",\n          data: [this.gamesWon, this.gamesLost],\n          backgroundColor: [\"#3c4e3b\", \"#662121\"],\n        },\n      ],\n    },\n    options: {\n      plugins: {\n        legend: {\n          position: 'top',\n          labels: {\n            padding: 20,\n          },\n        },\n      },\n      layout: {\n        padding: {\n          top: 0,\n          bottom: 0,\n          left: 0,\n          right: 0,\n        },\n      },\n      maintainAspectRatio: false,\n    },\n  });\n}\n\n};\n</script>\n\n<style scoped>\n.content {\n  color: #662121;\n  color: #3c4e3b;\n  color: rgb(255, 255, 255);\n  margin-left: 400px;\n  background-color: var(--background-color);\n  font-family: '8bit', sans-serif;\n}\n\n.profile-section {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 30px;\n  margin-bottom: 80px;\n}\n\n.profile-img {\n  border-radius: 50%;\n  width: 100px;\n  height: 100px;\n  margin-top: -40px;\n}\n\n.username {\n  font-size: 4rem;\n  margin-top: 0px;\n}\n\n.main-section {\n  display: flex;\n  justify-content: space-between;\n}\n\n.left-section {\n  width: 45%;\n}\n\n.stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 30px;\n}\n\n.stat {\n  text-align: center;\n  background-color: rgb(15,15,15);\n  padding: 30px;\n  border: 1px solid rgb(50, 50, 50);\n  border-radius: 8px;\n  font-size: 1.2rem;\n}\n\n.divider {\n  width: 2px;\n  background-color: grey;\n}\n\n.right-section {\n  width: 45%;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n}\n\ncanvas {\n  width: 100%;\n  max-width: 350px;\n}\n</style>\n"],"mappings":"AAoCA,OAAOA,KAAI,MAAO,eAAe;AAEjC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,UAAU;MACpB;MACAC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACV,MAAMC,GAAE,GAAIC,QAAQ,CAACC,cAAc,CAAC,YAAY,CAAC,CAACC,UAAU,CAAC,IAAI,CAAC;IAElE,MAAMC,MAAK,GAAIH,QAAQ,CAACC,cAAc,CAAC,YAAY,CAAC;IACpDE,MAAM,CAACC,MAAK,GAAI,GAAG;IAEnB,IAAIb,KAAK,CAACQ,GAAG,EAAE;MACbM,IAAI,EAAE,KAAK;MACXb,IAAI,EAAE;QACJc,MAAM,EAAE,CAAC,SAAS,EAAE,SAAS,CAAC;QAC9BC,QAAQ,EAAE,CACR;UACEC,KAAK,EAAE,SAAS;UAChBhB,IAAI,EAAE,CAAC,IAAI,CAACE,QAAQ,EAAE,IAAI,CAACC,SAAS,CAAC;UACrCc,eAAe,EAAE,CAAC,SAAS,EAAE,SAAS;QACxC,CAAC;MAEL,CAAC;MACDC,OAAO,EAAE;QACPC,OAAO,EAAE;UACPC,MAAM,EAAE;YACNC,QAAQ,EAAE,KAAK;YACfP,MAAM,EAAE;cACNQ,OAAO,EAAE;YACX;UACF;QACF,CAAC;QACDC,MAAM,EAAE;UACND,OAAO,EAAE;YACPE,GAAG,EAAE,CAAC;YACNC,MAAM,EAAE,CAAC;YACTC,IAAI,EAAE,CAAC;YACPC,KAAK,EAAE;UACT;QACF,CAAC;QACDC,mBAAmB,EAAE;MACvB;IACF,CAAC,CAAC;EACJ;AAEA,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}