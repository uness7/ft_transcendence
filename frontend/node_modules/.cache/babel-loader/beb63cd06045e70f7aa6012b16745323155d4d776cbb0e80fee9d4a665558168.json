{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport socket from \"../socket\";\nexport default {\n  data() {\n    return {\n      messages: [],\n      newMessage: \"\",\n      isChatOpen: false\n    };\n  },\n  created() {\n    socket.on(\"message\", message => {\n      this.messages.push(message);\n      this.$nextTick(() => {\n        this.scrollToBottom();\n      });\n    });\n  },\n  methods: {\n    sendMessage() {\n      if (this.newMessage.trim() !== \"\") {\n        socket.emit(\"message\", this.newMessage);\n        this.newMessage = \"\";\n      }\n    },\n    scrollToBottom() {\n      this.$nextTick(() => {\n        const messagesContainer = this.$refs.messagesContainer;\n        if (messagesContainer) {\n          messagesContainer.scrollTop = messagesContainer.scrollHeight;\n        }\n      });\n    },\n    toggleChat() {\n      this.isChatOpen = !this.isChatOpen;\n      this.$nextTick(() => {\n        if (this.isChatOpen) {\n          this.scrollToBottom();\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["socket","data","messages","newMessage","isChatOpen","created","on","message","push","$nextTick","scrollToBottom","methods","sendMessage","trim","emit","messagesContainer","$refs","scrollTop","scrollHeight","toggleChat"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/components/ChatVue.vue"],"sourcesContent":["<template>\n  <div class=\"chat-wrapper\">\n    <button @click=\"toggleChat\" class=\"toggle-button\">\n      <span v-if=\"isChatOpen\">▼</span>\n      <span v-else>▲</span>\n    </button>\n    <div v-if=\"isChatOpen\" class=\"chat\">\n      <div class=\"messages\" ref=\"messagesContainer\">\n        <div v-for=\"(message, index) in messages\" :key=\"index\" class=\"message\">\n          {{ message }}\n        </div>\n      </div>\n      <input v-model=\"newMessage\" @keyup.enter=\"sendMessage\" placeholder=\"Type a message...\" maxlength=\"100\"/>\n    </div>\n  </div>\n</template>\n\n<script>\n  import socket from \"../socket\";\n\n  export default {\n    data() {\n      return {\n        messages: [],\n        newMessage: \"\",\n        isChatOpen: false,\n      };\n    },\n    created() {\n      socket.on(\"message\", (message) => {\n        this.messages.push(message);\n        this.$nextTick(() => {\n          this.scrollToBottom();\n        });\n      });\n    },\n    methods: {\n      sendMessage() {\n        if (this.newMessage.trim() !== \"\") {\n          socket.emit(\"message\", this.newMessage);\n          this.newMessage = \"\";\n        }\n      },\n      scrollToBottom() {\n        this.$nextTick(() => {\n          const messagesContainer = this.$refs.messagesContainer;\n          if (messagesContainer) {\n            messagesContainer.scrollTop = messagesContainer.scrollHeight;\n          }\n        });\n      },\n      toggleChat() {\n        this.isChatOpen = !this.isChatOpen;\n        this.$nextTick(() => {\n          if (this.isChatOpen) {\n            this.scrollToBottom();\n          }\n        });\n      },\n    },\n  };\n</script>\n\n<style>\n  .chat-wrapper {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    width: 300px;\n  }\n\n  .toggle-button {\n    width: 100%;\n    background-color: #333;\n    color: var(--primary-color);\n    border: none;\n    cursor: pointer;\n    text-align: center;\n    font-size: 16px;\n    box-sizing: border-box;\n    margin: 0;\n    height: 30px;\n  }\n\n  .chat {\n    width: 100%;\n    height: 400px;\n    display: flex;\n    flex-direction: column;\n    background-color: #333;\n    overflow: hidden;\n    color: white;\n    border: 1px solid #333;\n    transition: height 0.3s ease;\n    box-sizing: border-box;\n  }\n\n  .messages {\n    flex: 1;\n    padding: 10px;\n    overflow-y: auto;\n    background-color: #444;\n    word-wrap: break-word;\n  }\n\n  .message {\n    padding: 8px;\n    margin-bottom: 4px;\n    border-radius: 5px;\n    background-color: #555;\n    color: rgb(255, 255, 255);\n    font-size: 17px;\n    overflow-wrap: break-word;\n  }\n\n  input {\n    padding: 8px;\n    border: none;\n    border-top: 1px solid var(--primary-color);\n    width: 100%;\n    box-sizing: border-box;\n    background-color: #333;\n    color: white;\n  }\n\n  input:focus {\n    outline: none;\n    border-top: 1px solid var(--primary-color);\n  }\n\n  input::placeholder {\n    color: #ffffff;\n  }\n</style>\n"],"mappings":";AAkBE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE,EAAE;MACdC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACRL,MAAM,CAACM,EAAE,CAAC,SAAS,EAAGC,OAAO,IAAK;MAChC,IAAI,CAACL,QAAQ,CAACM,IAAI,CAACD,OAAO,CAAC;MAC3B,IAAI,CAACE,SAAS,CAAC,MAAM;QACnB,IAAI,CAACC,cAAc,CAAC,CAAC;MACvB,CAAC,CAAC;IACJ,CAAC,CAAC;EACJ,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACT,UAAU,CAACU,IAAI,CAAC,MAAM,EAAE,EAAE;QACjCb,MAAM,CAACc,IAAI,CAAC,SAAS,EAAE,IAAI,CAACX,UAAU,CAAC;QACvC,IAAI,CAACA,UAAS,GAAI,EAAE;MACtB;IACF,CAAC;IACDO,cAAcA,CAAA,EAAG;MACf,IAAI,CAACD,SAAS,CAAC,MAAM;QACnB,MAAMM,iBAAgB,GAAI,IAAI,CAACC,KAAK,CAACD,iBAAiB;QACtD,IAAIA,iBAAiB,EAAE;UACrBA,iBAAiB,CAACE,SAAQ,GAAIF,iBAAiB,CAACG,YAAY;QAC9D;MACF,CAAC,CAAC;IACJ,CAAC;IACDC,UAAUA,CAAA,EAAG;MACX,IAAI,CAACf,UAAS,GAAI,CAAC,IAAI,CAACA,UAAU;MAClC,IAAI,CAACK,SAAS,CAAC,MAAM;QACnB,IAAI,IAAI,CAACL,UAAU,EAAE;UACnB,IAAI,CAACM,cAAc,CAAC,CAAC;QACvB;MACF,CAAC,CAAC;IACJ;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}