nslateX(-50%);\n        color: white;\n        font-family: '8bit';\n        text-align: center;\n        background-color: rgba(0, 0, 0, 0.5);\n        padding: 5px 10px;\n        border-radius: 5px;\n        font-size: 16px;\n    }\n\n    .card:hover {\n        transform: scale(1.1);\n    }\n\n    .lan-text {\n        font-size: 35px;\n    }\n\n    .multi-text {\n        font-size: 35px;\n    }\n\n    .tournament-mode {\n        text-align: center;\n    }\n\n    .tournament-btn {\n        font-family: '8bit';\n        font-size: 35px;\n        padding: 10px 20px;\n        background-color: rgba(0, 0, 0, 0.7);\n        color: white;\n        border: none;\n        border-radius: 10px;\n        cursor: not-allowed;\n    }\n</style>\n"],"mappings":"AAmCA,eAAe;EACXA,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,aAAa,EAAE,KAAK;MACpBC,cAAc,EAAE;IACpB,CAAC;EACL;AACJ,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}