{"ast":null,"code":"import GameView from '../views/GameView.vue';\nexport default {\n  components: {\n    GameView\n  },\n  data() {\n    return {\n      currentDifficulty: 'Medium',\n      // Difficulte par defaut\n      dropdownOpen: false\n    };\n  },\n  methods: {\n    toggleDropdown() {\n      this.dropdownOpen = !this.dropdownOpen;\n    },\n    closeDropdown() {\n      this.dropdownOpen = false;\n    },\n    setDifficulty(level) {\n      this.currentDifficulty = level.charAt(0).toUpperCase() + level.slice(1);\n      this.dropdownOpen = false; // Fermer le menu après sélection\n    }\n  }\n};","map":{"version":3,"names":["GameView","components","data","currentDifficulty","dropdownOpen","methods","toggleDropdown","closeDropdown","setDifficulty","level","charAt","toUpperCase","slice"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/views/AiView.vue"],"sourcesContent":["<template>\n    <div class=\"content\" @click=\"closeDropdown\">\n      <GameView/>\n      <div class=\"dropdown-container\" @click.stop>\n        <button class=\"dropdown-button\" @click=\"toggleDropdown\">\n          Difficulty: {{ currentDifficulty }}\n        </button>\n        <ul v-if=\"dropdownOpen\" class=\"dropdown-menu\">\n          <li @click=\"setDifficulty('easy')\">Easy</li>\n          <li @click=\"setDifficulty('medium')\">Medium</li>\n          <li @click=\"setDifficulty('hard')\">Hard</li>\n        </ul>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  import GameView from '../views/GameView.vue';\n  \n  export default {\n    components: {\n      GameView\n    },\n    data() {\n      return {\n        currentDifficulty: 'Medium', // Difficulte par defaut\n        dropdownOpen: false\n      };\n    },\n    methods: {\n      toggleDropdown() {\n        this.dropdownOpen = !this.dropdownOpen;\n      },\n      closeDropdown() {\n        this.dropdownOpen = false;\n      },\n      setDifficulty(level) {\n        this.currentDifficulty = level.charAt(0).toUpperCase() + level.slice(1);\n        this.dropdownOpen = false; // Fermer le menu après sélection\n      }\n    }\n  }\n  </script>\n  \n  <style scoped>\n  .content {\n    color: white;\n    background-color: var(--background-color);\n    margin-top: 200px; /* <--- ne pas trop changer */\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n    height: calc(100vh - 200px); /* Centrer verticalement */\n  }\n  \n  .dropdown-container {\n    position: relative;\n    display: inline-block;\n  }\n  \n  .dropdown-button {\n    background-color: var(--primary-color);\n    color: white;\n    padding: 5px 10px;\n    font-size: 12px;\n    border: none;\n    cursor: pointer;\n    border-radius: 5px;\n  }\n  \n  .dropdown-menu {\n    position: absolute;\n    background-color: rgba(0, 0, 0, 0.8);\n    color: white;\n    border: 1px solid white;\n    margin-top: 5px;\n    padding: 0;\n    list-style: none;\n    width: 100px;\n    text-align: center;\n    z-index: 1;\n  }\n  \n  .dropdown-menu li {\n    padding: 5px;\n    cursor: pointer;\n  }\n  \n  .dropdown-menu li:hover {\n    background-color: var(--primary-hover-color);\n  }\n  </style>\n  "],"mappings":"AAiBE,OAAOA,QAAO,MAAO,uBAAuB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,iBAAiB,EAAE,QAAQ;MAAE;MAC7BC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAAA,EAAG;MACf,IAAI,CAACF,YAAW,GAAI,CAAC,IAAI,CAACA,YAAY;IACxC,CAAC;IACDG,aAAaA,CAAA,EAAG;MACd,IAAI,CAACH,YAAW,GAAI,KAAK;IAC3B,CAAC;IACDI,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAI,CAACN,iBAAgB,GAAIM,KAAK,CAACC,MAAM,CAAC,CAAC,CAAC,CAACC,WAAW,CAAC,IAAIF,KAAK,CAACG,KAAK,CAAC,CAAC,CAAC;MACvE,IAAI,CAACR,YAAW,GAAI,KAAK,EAAE;IAC7B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}