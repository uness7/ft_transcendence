1 /* STABLE */\n  }), !$data.isLoggedIn ? (_openBlock(), _createBlock(_component_router_link, {\n    key: 0,\n    to: \"/login\",\n    id: \"login-button\"\n  }, {\n    default: _withCtx(() => [_createTextVNode(_toDisplayString(_ctx.$t('login')), 1 /* TEXT */)]),\n    _: 1 /* STABLE */\n  })) : (_openBlock(), _createElementBlock(\"div\", _hoisted_4, [_createElementVNode(\"button\", _hoisted_5, _toDisplayString($data.user?.username), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_6, [_createVNode(_component_router_link, {\n    to: \"/user/1\"\n  }, {\n    default: _withCtx(() => [_createTextVNode(_toDisplayString(_ctx.$t('profile')), 1 /* TEXT */)]),\n    _: 1 /* STABLE */\n  }), _createVNode(_component_router_link, {\n    to: \"/user/settings\"\n  }, {\n    default: _withCtx(() => [_createTextVNode(_toDisplayString(_ctx.$t('settings')), 1 /* TEXT */)]),\n    _: 1 /* STABLE */\n  }), _createVNode(_component_router_link, {\n    to: \"/\",\n    id: \"logout-button\"\n  }, {\n    default: _withCtx(() => [_createTextVNode(_toDisplayString(_ctx.$t('logout')), 1 /* TEXT */)]),\n    _: 1 /* STABLE */\n  })])]))])]), _createVNode(_component_router_view)], 64 /* STABLE_FRAGMENT */);\n}","map":{"version":3,"names":["class","id","key","_createElementBlock","_Fragment","_createElementVNode","_hoisted_1","_hoisted_2","_createCommentVNode","_createVNode","_component_router_link","to","default","_withCtx","_createTextVNode","_","src","$options","currentFlag","alt","onClick","_cache","args","toggleLanguage","_hoisted_3","_toDisplayString","_ctx","$t","$data","isLoggedIn","_createBlock","_hoisted_4","_hoisted_5","user","username","_hoisted_6","_component_router_view"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"top-bar\">\n    <header id=\"top-bar-content\">\n      <!-- <router-link to=\"/\"><img src='./assets/img/logo1.png' id=\"main-image\"/></router-link> -->\n      <router-link to=\"/\" id=\"logo-text\">ft_transcendence</router-link>\n      <img :src=\"currentFlag\" alt=\"flag\" id=\"language-flag\" @click=\"toggleLanguage\">\n      <router-link to=\"/about\" id=\"about-button\">{{ $t('about') }}</router-link>\n      <router-link v-if=\"!isLoggedIn\" to=\"/login\" id=\"login-button\">{{ $t('login') }}</router-link>\n      <div v-else class=\"dropdown\">\n        <button class=\"dropbtn\">{{ user?.username }}</button>\n        <div class=\"dropdown-content\">\n          <router-link to=\"/user/1\">{{ $t('profile') }}</router-link>\n          <router-link to=\"/user/settings\">{{ $t('settings') }}</router-link>\n          <router-link to=\"/\" id=\"logout-button\">{{ $t('logout') }}</router-link>\n        </div>\n      </div>\n    </header>\n  </div>\n  <router-view/>\n</template>\n\n<script>\nimport axios from 'axios';\nimport { isAuthenticated } from './router/index';\n\nexport default {\n  data() {\n    return {\n      languages: ['en', 'fr', 'es'],\n      flags: {\n        en: require('./assets/img/flags/english.png'),\n        fr: require('./assets/img/flags/french.png'),\n        es: require('./assets/img/flags/spanish.png')\n      },\n      currentLanguageIndex: 0,\n      isLoggedIn: false,\n      user: {\n        username: ''\n      },\n      id: 1, // pour test\n    };\n  },\n  computed: {\n    currentFlag() {\n      return this.flags[this.languages[this.currentLanguageIndex]];\n    }\n  },\n  methods: {\n    toggleLanguage() {\n      this.currentLanguageIndex = (this.currentLanguageIndex + 1) % this.languages.length;\n      const selectedLanguage = this.languages[this.currentLanguageIndex];\n      this.$i18n.locale = selectedLanguage;\n\n      // stock la langue dans le localstorage pour garder le choix permanent\n      localStorage.setItem('selectedLanguage', selectedLanguage);\n    },\n    fetchUser() {\n      axios.get(`https://jsonplaceholder.typicode.com/users/${this.id}`)\n        .then(response => {\n          this.user = response.data;\n        })\n        .catch(error => {\n          console.error('Erreur:', error);\n        });\n    },\n    checkLoginStatus() {\n      if (isAuthenticated()) {\n        this.isLoggedIn = true;\n        this.fetchUser();\n      } else {\n        this.isLoggedIn = false;\n      }\n    },\n    applyPrimaryColor() {\n      const color = localStorage.getItem('primaryColor') || '#FFFFFF';\n      document.documentElement.style.setProperty('--primary-color', color);\n    },\n    loadSavedLanguage() {\n      // recupere la langue depuis le localstorage\n      const savedLanguage = localStorage.getItem('selectedLanguage');\n      if (savedLanguage) {\n        this.currentLanguageIndex = this.languages.indexOf(savedLanguage);\n        this.$i18n.locale = savedLanguage;\n      }\n    }\n  },\n  created() {\n    this.checkLoginStatus();\n    this.loadSavedLanguage();\n  },\n  mounted() {\n    this.applyPrimaryColor();\n  }\n}\n\n</script>\n\n<style scoped>\n\n/*  ##### GLOBAL  ##### */\n\n  @font-face {\n      font-family: '8bit';\n      src: url('./assets/font/8bit.ttf') format('truetype');\n  }\n  :global(body) {\n    background-color: var(--background-color);\n  }\n\n/*  ##### HEADER  ##### */  \n\n  .top-bar {\n    width: 100%;\n    background-color: var(--background-color);\n    position: fixed;\n    top: 0;\n    left: 0;\n    display: flex;\n    align-items: center;\n    border-bottom: 1px solid rgb(70, 70, 70);\n  }\n\n  #top-bar-content{\n    margin-top: 20px;\n    font-family: '8bit', sans-serif;\n    color: white;\n    margin-bottom: 20px;\n  }\n\n  #logo-text {\n    font-family: '8bit', sans-serif;\n    font-size: 40px;\n    text-decoration: none;\n    background-color: rgb(25, 25, 25);\n    color: var(--primary-color);\n    height: 100%;\n    padding-left: 20px;\n    padding-right: 20px;\n    padding-top: 30px;\n    padding-bottom: 29px;\n    box-sizing: border-box;\n    border-bottom: 1px solid rgb(70,70,70);\n    border-right: 1px solid rgb(70,70,70);\n  }\n\n  #language-flag {\n    width: 3%;\n    position: absolute;\n    right: 350px;\n    cursor: pointer;\n    transition: transform 0.3s ease;\n  }\n\n  #language-flag:hover {\n    transform: scale(1.1);\n  }\n\n  #about-button {\n    background-color: rgb(10, 10, 10);\n    border: none;\n    text-decoration: none;\n    color: rgb(255, 255, 255);\n    font-size: xx-large;\n    position: absolute;\n    right: 200px;\n    font-family: '8bit', sans-serif;\n    transition: all 0.2s ease;\n  }\n\n  #about-button:hover {\n    transform: scale(1.05);\n    color: var(--primary-color);\n  }\n\n  #login-button {\n    margin-right: 10px;\n    background-color: rgb(10, 10, 10);\n    border: none;\n    text-decoration: none;\n    color: rgb(255, 255, 255);\n    font-size: xx-large;\n    position: absolute;\n    right: 50px;\n    font-family: '8bit', sans-serif;\n    transition: all 0.2s ease;\n  }\n\n  #login-button:hover {\n    transform: scale(1.05);\n    color: var(--primary-color);\n  }\n\n  #logout-button{\n    background-color: darkred;\n  }\n\n  #logout-button:hover{\n    background-color: rgb(200,0,0);\n  }\n\n  .dropbtn {\n    background-color: var(--background-color);\n    color: rgb(255, 255, 255);\n    font-size: xx-large;\n    border: none;\n    cursor: pointer;\n    font-family: '8bit', sans-serif;\n    transition: all 0.2s ease;\n    padding-bottom: 15px;\n  }\n\n  .dropbtn:hover{\n    color: var(--primary-color);\n  }\n\n  .dropdown {\n    position: absolute;\n    right: 50px;\n    top: 20px;\n    font-family: '8bit', sans-serif;\n  }\n\n  .dropdown-content {\n    font-size: 20px;\n    padding-top: 10px;\n    display: none;\n    position: absolute;\n    background-color: var(--background-color);\n    min-width: 160px;\n    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);\n    z-index: 1;\n  }\n\n  .dropdown-content a {\n    color: rgb(255, 255, 255);\n    padding: 12px 16px;\n    text-decoration: none;\n    display: block;\n  }\n\n  .dropdown-content a:hover {\n    background-color: rgb(20, 20, 20);\n    color: white;\n  }\n\n  .dropdown:hover .dropdown-content {\n    display: block;\n  }\n\n  .dropdown:hover .dropbtn {\n    background-color: var(--background-color);\n    color: var(--primary-color);\n  }\n\n</style>\n"],"mappings":";;;EACOA,KAAK,EAAC;AAAS;;EACVC,EAAE,EAAC;AAAiB;mBAFhC;;EAAAC,GAAA;EAQkBF,KAAK,EAAC;;;EACRA,KAAK,EAAC;AAAS;;EAClBA,KAAK,EAAC;AAAkB;;;;uBAVrCG,mBAAA,CAAAC,SAAA,SACEC,mBAAA,CAgBM,OAhBNC,UAgBM,GAfJD,mBAAA,CAcS,UAdTE,UAcS,GAbPC,mBAAA,+FAA8F,EAC9FC,YAAA,CAAiEC,sBAAA;IAApDC,EAAE,EAAC,GAAG;IAACV,EAAE,EAAC;;IAJ7BW,OAAA,EAAAC,QAAA,CAIyC,MAAgB,CAJzDC,gBAAA,CAIyC,kBAAgB,E;IAJzDC,CAAA;MAKMV,mBAAA,CAA8E;IAAxEW,GAAG,EAAEC,QAAA,CAAAC,WAAW;IAAEC,GAAG,EAAC,MAAM;IAAClB,EAAE,EAAC,eAAe;IAAEmB,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEL,QAAA,CAAAM,cAAA,IAAAN,QAAA,CAAAM,cAAA,IAAAD,IAAA,CAAc;0BALlFE,UAAA,GAMMf,YAAA,CAA0EC,sBAAA;IAA7DC,EAAE,EAAC,QAAQ;IAACV,EAAE,EAAC;;IANlCW,OAAA,EAAAC,QAAA,CAMiD,MAAiB,CANlEC,gBAAA,CAAAW,gBAAA,CAMoDC,IAAA,CAAAC,EAAE,0B;IANtDZ,CAAA;OAO0Ba,KAAA,CAAAC,UAAU,I,cAA9BC,YAAA,CAA6FpB,sBAAA;IAPnGR,GAAA;IAOsCS,EAAE,EAAC,QAAQ;IAACV,EAAE,EAAC;;IAPrDW,OAAA,EAAAC,QAAA,CAOoE,MAAiB,CAPrFC,gBAAA,CAAAW,gBAAA,CAOuEC,IAAA,CAAAC,EAAE,0B;IAPzEZ,CAAA;uBAQMZ,mBAAA,CAOM,OAPN4B,UAOM,GANJ1B,mBAAA,CAAqD,UAArD2B,UAAqD,EAAAP,gBAAA,CAA1BG,KAAA,CAAAK,IAAI,EAAEC,QAAQ,kBACzC7B,mBAAA,CAIM,OAJN8B,UAIM,GAHJ1B,YAAA,CAA2DC,sBAAA;IAA9CC,EAAE,EAAC;EAAS;IAXnCC,OAAA,EAAAC,QAAA,CAWoC,MAAmB,CAXvDC,gBAAA,CAAAW,gBAAA,CAWuCC,IAAA,CAAAC,EAAE,4B;IAXzCZ,CAAA;MAYUN,YAAA,CAAmEC,sBAAA;IAAtDC,EAAE,EAAC;EAAgB;IAZ1CC,OAAA,EAAAC,QAAA,CAY2C,MAAoB,CAZ/DC,gBAAA,CAAAW,gBAAA,CAY8CC,IAAA,CAAAC,EAAE,6B;IAZhDZ,CAAA;MAaUN,YAAA,CAAuEC,sBAAA;IAA1DC,EAAE,EAAC,GAAG;IAACV,EAAE,EAAC;;IAbjCW,OAAA,EAAAC,QAAA,CAaiD,MAAkB,CAbnEC,gBAAA,CAAAW,gBAAA,CAaoDC,IAAA,CAAAC,EAAE,2B;IAbtDZ,CAAA;eAkBEN,YAAA,CAAc2B,sBAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}