{"ast":null,"code":"//import axios from 'axios';\n\nexport default {\n  data() {\n    return {\n      stats: null,\n      loading: true\n    };\n  },\n  mounted() {\n    // Mock data for testing purpose\n    this.stats = {\n      total_games_played: 25,\n      total_wins: 15,\n      total_losses: 10,\n      highest_score: 200,\n      average_score: 150.5\n    };\n    this.loading = false;\n\n    // Uncomment this block when testing with the real API\n    /*\n      const userId = this.$route.params.userId;  // Assuming userId comes from the route\n      axios.get(`/api/stats/${userId}`)\n        .then(response => {\n          this.stats = response.data;\n          this.loading = false;\n        })\n        .catch(error => {\n          console.error(\"Error fetching user stats:\", error);\n          this.loading = false;\n        });\n        */\n  }\n};","map":{"version":3,"names":["data","stats","loading","mounted","total_games_played","total_wins","total_losses","highest_score","average_score"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/views/UserDashboard.vue"],"sourcesContent":["<template>\n    <div class=\"content\">\n\n        <div class=\"dashboard\">\n            <h2>User Statistics</h2>\n            <div v-if=\"loading\">\n                <p>Loading stats...</p>\n            </div>\n            <div v-else-if=\"stats\">\n                <p><strong>Total Games Played:</strong> {{ stats.total_games_played }}</p>\n                <p><strong>Total Wins:</strong> {{ stats.total_wins }}</p>\n                <p><strong>Total Losses:</strong> {{ stats.total_losses }}</p>\n                <p><strong>Highest Score:</strong> {{ stats.highest_score }}</p>\n                <p><strong>Average Score:</strong> {{ stats.average_score.toFixed(2) }}</p>\n            </div>\n            <div v-else>\n                <p>No stats available.</p>\n            </div>\n        </div>\n    </div>\n    </template>\n  \n  <script>\n  //import axios from 'axios';\n  \n  export default {\n    data() {\n      return {\n        stats: null,\n        loading: true,\n      };\n    },\n    mounted() {\n        // Mock data for testing purpose\n    this.stats = {\n      total_games_played: 25,\n      total_wins: 15,\n      total_losses: 10,\n      highest_score: 200,\n      average_score: 150.5,\n    };\n    this.loading = false;\n\n    // Uncomment this block when testing with the real API\n    /*\n      const userId = this.$route.params.userId;  // Assuming userId comes from the route\n      axios.get(`/api/stats/${userId}`)\n        .then(response => {\n          this.stats = response.data;\n          this.loading = false;\n        })\n        .catch(error => {\n          console.error(\"Error fetching user stats:\", error);\n          this.loading = false;\n        });\n        */\n    },\n  };\n  </script>\n  \n\n<style scoped>\n    @font-face {\n        font-family: '8bit';\n        src: url('../assets/font/8bit.ttf') format('truetype');\n        }\n\n    .content {\n        color: white;\n        margin-top: 300px;\n        font-family: '8bit',sans-serif;\n        display: flex;\n        justify-content: center;\n    }\n  .dashboard {\n    padding: 20px;\n    font-family: Arial, sans-serif;\n  }\n  .dashboard {\n  display: flex;\n  flex-direction: column;\n  gap: 15px;\n}\n\n.game-history {\n  margin-top: 20px;\n}\n\n.game-session {\n  border: 1px solid #ccc;\n  padding: 10px;\n  margin-bottom: 10px;\n  border-radius: 5px;\n}\n\n.loading {\n  text-align: center;\n}\n\n  </style>\n  "],"mappings":"AAuBE;;AAEA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN;IACJ,IAAI,CAACF,KAAI,GAAI;MACXG,kBAAkB,EAAE,EAAE;MACtBC,UAAU,EAAE,EAAE;MACdC,YAAY,EAAE,EAAE;MAChBC,aAAa,EAAE,GAAG;MAClBC,aAAa,EAAE;IACjB,CAAC;IACD,IAAI,CAACN,OAAM,GAAI,KAAK;;IAEpB;IACA;;;;;;;;;;;;EAYA;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}