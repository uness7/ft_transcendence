{"ast":null,"code":"import Chart from \"chart.js/auto\";\nexport default {\n  data() {\n    return {\n      username: \"Player1\",\n      profileImageUrl: \"https://via.placeholder.com/100\",\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3\n    };\n  },\n  mounted() {\n    const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n    new Chart(ctx, {\n      type: \"pie\",\n      data: {\n        labels: [\"Gagnées\", \"Perdues\"],\n        datasets: [{\n          label: \"Parties\",\n          data: [this.gamesWon, this.gamesLost],\n          backgroundColor: [\"#555\", \"#333\"]\n        }]\n      }\n    });\n  }\n};","map":{"version":3,"names":["Chart","data","username","profileImageUrl","gamesWon","gamesLost","winRate","tournamentsWon","mounted","ctx","document","getElementById","getContext","type","labels","datasets","label","backgroundColor"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/components/UserProfile.vue"],"sourcesContent":["<template>\n  <div class=\"content\">\n    <div class=\"profile-section\">\n      <h1 class=\"username\">{{ username }}</h1>\n      <img :src=\"profileImageUrl\" alt=\"Profile Image\" class=\"profile-img\">\n    </div>\n    <div class=\"main-section\">\n      <div class=\"left-section\">\n        <div class=\"stat-grid\">\n          <div class=\"stat\">\n            <h2>Parties gagnées</h2>\n            <p>{{ gamesWon }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Parties perdues</h2>\n            <p>{{ gamesLost }}</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Winrate</h2>\n            <p>{{ winRate }}%</p>\n          </div>\n          <div class=\"stat\">\n            <h2>Tournois gagnés</h2>\n            <p>{{ tournamentsWon }}</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"divider\"></div>\n      <div class=\"right-section\">\n        <canvas id=\"gamesChart\"></canvas>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport Chart from \"chart.js/auto\";\n\nexport default {\n  data() {\n    return {\n      username: \"Player1\",\n      profileImageUrl: \"https://via.placeholder.com/100\",\n      gamesWon: 20,\n      gamesLost: 15,\n      winRate: 57,\n      tournamentsWon: 3,\n    };\n  },\n  mounted() {\n    const ctx = document.getElementById(\"gamesChart\").getContext(\"2d\");\n    new Chart(ctx, {\n      type: \"pie\",\n      data: {\n        labels: [\"Gagnées\", \"Perdues\"],\n        datasets: [\n          {\n            label: \"Parties\",\n            data: [this.gamesWon, this.gamesLost],\n            backgroundColor: [\"#555\", \"#333\"],\n          },\n        ],\n      },\n    });\n  },\n};\n</script>\n\n<style scoped>\n.content {\n  color: white;\n  margin-top: 80px;\n  margin-left: 400px;\n  background-color: var(--background-color);\n  padding: 20px;\n  font-family: '';\n}\n\n.profile-section {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.profile-img {\n  border-radius: 50%;\n  width: 100px;\n  height: 100px;\n}\n\n.username {\n  font-size: 2rem;\n}\n\n.main-section {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 30px;\n}\n\n.left-section {\n  width: 45%;\n}\n\n.stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 30px;\n}\n\n.stat {\n  text-align: center;\n  background-color: var(--background-color);\n  padding: 30px;\n  border: 1px solid rgb(30, 30, 30);\n  border-radius: 8px;\n  font-size: 1.2rem;\n}\n\n.divider {\n  width: 2px;\n  background-color: grey;\n}\n\n.right-section {\n  width: 45%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\ncanvas {\n  width: 100%;\n  max-width: 350px;\n}\n</style>\n"],"mappings":"AAoCA,OAAOA,KAAI,MAAO,eAAe;AAEjC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,SAAS;MACnBC,eAAe,EAAE,iCAAiC;MAClDC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,OA