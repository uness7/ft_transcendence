{"ast":null,"code":"import GameView from '../views/GameView.vue';\nexport default {\n  components: {\n    GameView\n  },\n  data() {\n    return {\n      currentDifficulty: 'medium'\n    };\n  },\n  methods: {\n    setDifficulty(level) {\n      this.currentDifficulty = level;\n    }\n  }\n};","map":{"version":3,"names":["GameView","components","data","currentDifficulty","methods","setDifficulty","level"],"sources":["/goinfre/jnorget/ft_transcendence/frontend/src/views/AiView.vue"],"sourcesContent":["<template>\n    <div class=\"content\">\n      <GameView />\n      <div class=\"dropdown\">\n        <button class=\"dropbtn\" :class=\"currentDifficulty\">\n          {{ $t('difficulty') }} : {{ $t(currentDifficulty) }}\n        </button>\n        <div class=\"dropdown-content\">\n          <button @click=\"setDifficulty('easy')\" class=\"easy\">{{ $t('easy') }}</button>\n          <button @click=\"setDifficulty('medium')\" class=\"medium\">{{ $t('medium') }}</button>\n          <button @click=\"setDifficulty('hard')\" class=\"hard\">{{ $t('hard') }}</button>\n        </div>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  import GameView from '../views/GameView.vue';\n  \n  export default {\n    components: {\n      GameView,\n    },\n    data() {\n      return {\n        currentDifficulty: 'medium',\n      };\n    },\n    methods: {\n      setDifficulty(level) {\n        this.currentDifficulty = level;\n      },\n    },\n  };\n  </script>\n  \n  <style scoped>\n  @font-face {\n    font-family: '8bit';\n    src: url('../assets/font/8bit.ttf') format('truetype');\n  }\n  \n  .content {\n    color: white;\n    background-color: var(--background-color);\n    margin-top: 200px;\n    font-family: '8bit', sans-serif;\n  }\n  \n  .dropbtn {\n    background-color: var(--background-color);\n    color: rgb(255, 255, 255);\n    font-size: x-large;\n    border: none;\n    border-bottom: 1px solid grey;\n    cursor: pointer;\n    font-family: '8bit', sans-serif;\n    transition: all 0.2s ease;\n    padding-bottom: 15px;\n  }\n  \n  .dropdown {\n    position: absolute;\n    right: 70px;\n    top: 450px;\n    font-family: '8bit', sans-serif;\n  }\n  \n  .dropdown-content {\n    font-size: 10px;\n    padding-top: 10px;\n    display: none;\n    position: absolute;\n    background-color: var(--background-color);\n    min-width: 160px;\n    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);\n    z-index: 1;\n  }\n  \n  .dropdown-content button {\n    background-color: var(--background-color);\n    padding: 12px 16px;\n    border: none;\n    border-bottom: 1px solid grey;\n    font-size: 18px;\n    text-align: left;\n    cursor: pointer;\n    width: 100%;\n    font-family: '8bit', sans-serif;\n  }\n  \n  .dropdown:hover .dropdown-content {\n    display: block;\n  }\n  \n  .easy {\n    color: rgb(15, 126, 0);\n  }\n  \n  .medium {\n    color: rgb(233, 132, 0);\n  }\n  \n  .hard {\n    color: rgb(168, 0, 0);\n  }\n  </style>\n  "],"mappings":"AAiBE,OAAOA,QAAO,MAAO,uBAAuB;AAE5C,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,iBAAiB,EAAE;IACrB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAI,CAACH,iBAAgB,GAAIG,KAAK;IAChC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}